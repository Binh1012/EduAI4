# Copy to .env and edit. Never commit .env
DATABASE_URL=sqlite:///./eduai.db
# PostgreSQL example: postgresql+psycopg2://user:pass@localhost:5432/eduai
SECRET_KEY=change-this-to-a-long-random-string
TOKEN_MINUTES=10080
# AI tutor (leave empty to use the built-in fallback reply)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_RATE_LIMIT_PER_HOUR=20
WEAK_THRESHOLD=60
